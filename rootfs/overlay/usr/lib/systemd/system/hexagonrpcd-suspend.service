[Unit]
Description=Stop hexagonrpcd sensor daemons before suspend
ConditionFirmware=device-tree-compatible(qcom,sm8150)
Before=suspend.target
DefaultDependencies=no

[Service]
Type=oneshot
# Only the topology that is actually live on this kernel is touched; see
# /usr/local/bin/nabu-sensor-bridge.
ExecStart=/usr/local/bin/nabu-sensor-bridge stop
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict

[Install]
WantedBy=suspend.target
