[Unit]
Description=Restart hexagonrpcd sensor daemons after resume
ConditionFirmware=device-tree-compatible(qcom,sm8150)
After=suspend.target
DefaultDependencies=no

[Service]
Type=oneshot
# Only the topology that is actually live on this kernel is touched; see
# /usr/local/bin/nabu-sensor-bridge.
ExecStart=/usr/local/bin/nabu-sensor-bridge start
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=closed
ProtectSystem=strict

[Install]
WantedBy=suspend.target
