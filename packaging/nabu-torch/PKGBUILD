package_nabu-torch() {
  pkgdesc="Hardware camera flashlight and torch controller with intensity control for Xiaomi Pad 5 (nabu)"
  provides=('flashlight')

  install -Dm755 "$srcdir/torch" "$pkgdir/usr/bin/torch"
  ln -sf torch "$pkgdir/usr/bin/nabu-torch"
  ln -sf torch "$pkgdir/usr/bin/flashlight"
  install -Dm644 "$srcdir/torch.desktop" "$pkgdir/usr/share/applications/torch.desktop"
  install -Dm644 "$srcdir/torch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/torch.svg"
  install -Dm644 "$srcdir/torch.svg" "$pkgdir/usr/share/pixmaps/torch.svg"
  install -Dm644 "$srcdir/90-torch.rules" "$pkgdir/usr/lib/udev/rules.d/90-torch.rules"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_torch() {
  pkgdesc="Hardware camera flashlight and torch controller (metapackage for nabu-torch)"
  depends=('nabu-torch')
}
