#!/usr/bin/bash
# Wait until the SLPI sensor stack is up before iio-sensor-proxy starts.
#
# Wants=/After= on the hexagonrpcd units only order the start — they do not
# guarantee the daemon ever succeeded. If it fails early, iio-sensor-proxy
# still races in, finds no Sensor Manager service on QRTR, and the sensor
# stack stays dead until the next reboot. This ExecStartPre helper polls for
# the FastRPC device and the active daemon.
#
# Two models exist and either one counts as ready:
#   - 6.17/adsp: /dev/fastrpc-adsp + hexagonrpcd-adsp-sensorspd.service
#   - 7.3/sdsp:  /dev/fastrpc-sdsp + hexagonrpcd-sdsp.service
#     (on that kernel the adsp pair skips itself via ConditionPathExists)
#
# Best-effort: when the timeout expires the caller still starts, so a broken
# stack degrades the same way it always did instead of blocking boot.
set -u

TIMEOUT="${SLPI_WAIT_TIMEOUT:-60}"
DEVICES="/dev/fastrpc-adsp /dev/fastrpc-sdsp"
UNITS="hexagonrpcd-adsp-sensorspd.service hexagonrpcd-sdsp.service"

elapsed=0
while [ "${elapsed}" -lt "${TIMEOUT}" ]; do
    device_ok=0
    unit_ok=0
    for dev in ${DEVICES}; do
        [ -e "${dev}" ] && device_ok=1
    done
    for unit in ${UNITS}; do
        systemctl is-active --quiet "${unit}" 2>/dev/null && unit_ok=1
    done
    if [ "${device_ok}" -eq 1 ] && [ "${unit_ok}" -eq 1 ]; then
        echo "SLPI sensor stack ready after ${elapsed}s."
        exit 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done

echo "WARNING: SLPI sensor stack not ready after ${TIMEOUT}s" \
     "(device=${device_ok}, unit=${unit_ok}) — starting iio-sensor-proxy anyway." >&2
exit 0
