#!/usr/bin/env python3
"""First-run welcome dialog for CachyOS Nabu (Xiaomi Pad 5)."""
import os
import sys
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gio, GLib  # noqa: E402


def marker_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.environ.get("HOME", str(Path.home())), ".config"
    )
    return Path(base) / "nabu-cachyos" / "welcome-done"


def write_marker() -> None:
    p = marker_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.touch()


def launch_program(argv: list[str]) -> None:
    try:
        Gio.Subprocess.new(argv, Gio.SubprocessFlags.NONE)
    except GLib.Error as exc:
        sys.stderr.write(f"nabu-welcome: failed to launch {argv!r}: {exc}\n")


def on_change_password(_button: Gtk.Button) -> None:
    launch_program(["gnome-control-center", "user-accounts"])


def on_install_apps(_button: Gtk.Button) -> None:
    binary = GLib.find_program_in_path("cachyos-packageinstaller") \
        or GLib.find_program_in_path("gnome-software")
    if binary:
        launch_program([binary])


def on_read_readme(_button: Gtk.Button) -> None:
    try:
        Gio.AppInfo.launch_default_for_uri(
            "https://github.com/FisiFla/nabu-cachyos", None
        )
    except GLib.Error as exc:
        sys.stderr.write(f"nabu-welcome: failed to open URL: {exc}\n")


def make_button(label: str, handler) -> Gtk.Button:
    btn = Gtk.Button(label=label)
    btn.set_size_request(-1, 48)
    btn.connect("clicked", handler)
    return btn


class WelcomeApp(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id="xyz.fisicaro.NabuWelcome")

    def do_activate(self) -> None:
        win = Gtk.ApplicationWindow(application=self)
        win.set_title("Welcome to CachyOS Nabu")
        win.set_default_size(480, 520)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_margin_top(24)
        box.set_margin_bottom(24)
        box.set_margin_start(24)
        box.set_margin_end(24)

        header = Gtk.Label(label="Welcome, nabu")
        header.add_css_class("title-1")
        header.set_xalign(0.0)
        box.append(header)

        body = Gtk.Label(
            label=(
                "This is your first boot of CachyOS on the Xiaomi Pad 5. "
                "The default user is 'nabu' and ships with NO password — "
                "intentional, because a lock screen with a blank password "
                "is unrecoverable on this build. If you want a password "
                "(needed before enabling a lock screen or exposing SSH "
                "with PasswordAuthentication), set one via the button "
                "below. Otherwise, use the other buttons to get started."
            )
        )
        body.set_wrap(True)
        body.set_xalign(0.0)
        box.append(body)

        box.append(make_button("Change password", on_change_password))
        box.append(make_button("Install apps", on_install_apps))
        box.append(make_button("Read the README", on_read_readme))

        def on_close(_btn: Gtk.Button) -> None:
            write_marker()
            win.close()
            self.quit()

        box.append(make_button("Close", on_close))

        win.set_child(box)
        win.present()


def main() -> int:
    if marker_path().exists():
        return 0
    return WelcomeApp().run(None)


if __name__ == "__main__":
    sys.exit(main())
