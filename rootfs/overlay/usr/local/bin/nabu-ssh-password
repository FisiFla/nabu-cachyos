#!/usr/bin/bash
# Enable or disable SSH password authentication for the nabu user.
#
# Password authentication is OFF by default (see /etc/ssh/sshd_config.d/
# nabu.conf). Turning it on writes an earlier-sorting drop-in so it wins:
# sshd reads /etc/ssh/sshd_config.d/*.conf in lexicographic order and keeps
# the FIRST value of each keyword, and "10-nabu-password.conf" sorts before
# "nabu.conf".
#
# Root stays key-only either way (PermitRootLogin prohibit-password).
set -euo pipefail

CONF_DIR="/etc/ssh/sshd_config.d"
OPT_IN_CONF="${CONF_DIR}/10-nabu-password.conf"

usage() {
    cat << 'EOF'
Usage: nabu-ssh-password on|off

  on   allow SSH password authentication for the nabu user
  off  disable SSH password authentication (default)

Root keeps key-only SSH either way (PermitRootLogin prohibit-password).
EOF
}

case "${1:-}" in
    on)
        mkdir -p "${CONF_DIR}"
        cat > "${OPT_IN_CONF}" << 'EOF'
# Written by nabu-ssh-password on
PasswordAuthentication yes
EOF
        chmod 644 "${OPT_IN_CONF}"
        echo "SSH password authentication enabled (${OPT_IN_CONF})."
        ;;
    off)
        rm -f "${OPT_IN_CONF}"
        echo "SSH password authentication disabled."
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac

if command -v systemctl >/dev/null 2>&1; then
    systemctl restart sshd 2>/dev/null || systemctl reload sshd 2>/dev/null || true
fi
