diff --git a/hexagonrpcd/rpcd.c b/hexagonrpcd/rpcd.c
index 600237b..c9add99 100644
--- a/hexagonrpcd/rpcd.c
+++ b/hexagonrpcd/rpcd.c
@@ -78,6 +78,7 @@ static void print_usage(const char *argv0)
 	       "\t-p PROGRAM\tRun client program with shared file descriptor\n"
 	       "\t-R DIR\t\tRoot directory of served files (default: /usr/share/qcom/)\n"
 	       "\t-s\t\tAttach to sensorspd\n"
+	       "\t-S NAME\t\tCreate a new static pd with the given name (e.g. sensorspd, audiopd)\n"
 	       "\t-h\t\tPrint help and exit\n");
 }
 
@@ -350,6 +351,7 @@ int main(int argc, char* argv[])
 	const char *device_dir = "/usr/share/qcom/";
 	const char *dsp = "";
 	const char *create_shell = NULL;
+	const char *create_static_name = NULL;
 	const char *guessed_device_dir;
 	const char **progs;
 	pid_t *pids;
@@ -373,7 +375,7 @@ int main(int argc, char* argv[])
 	if (guessed_device_dir != NULL)
 		device_dir = guessed_device_dir;
 
-	while ((opt = getopt(argc, argv, "c:d:f:p:R:sh")) != -1) {
+	while ((opt = getopt(argc, argv, "c:d:f:p:R:sS:h")) != -1) {
 		switch (opt) {
 			case 'c':
 				create_shell = optarg;
@@ -397,6 +399,8 @@ int main(int argc, char* argv[])
 			case 'h':
 				print_usage(argv[0]);
 				goto free_pids;
+			case 'S':
+				create_static_name = optarg;
 				break;
 			default:
 				print_usage(argv[0]);
@@ -409,7 +413,9 @@ int main(int argc, char* argv[])
 		goto err_free_pids;
 	}
 
-	printf("Starting %s (%s) on %s\n", argv[0], attach_sns? "INIT_ATTACH_SNS": "INIT_ATTACH", fastrpc_node);
+	printf("Starting %s (%s) on %s\n", argv[0],
+		create_static_name ? "INIT_CREATE_STATIC" :
+		(attach_sns ? "INIT_ATTACH_SNS" : "INIT_ATTACH"), fastrpc_node);
 
 	fd = open(fastrpc_node, O_RDWR);
 	if (fd < 0) {
@@ -417,7 +423,14 @@ int main(int argc, char* argv[])
 		goto err_free_pids;
 	}
 
-	if (attach_sns)
+	if (create_static_name != NULL) {
+		struct fastrpc_init_create_static init = {
+			.namelen = strlen(create_static_name),
+			.memlen = 3 * 1024 * 1024,
+			.name = (__u64)(uintptr_t) create_static_name,
+		};
+		ret = ioctl(fd, FASTRPC_IOCTL_INIT_CREATE_STATIC, &init);
+	} else if (attach_sns)
 		ret = ioctl(fd, FASTRPC_IOCTL_INIT_ATTACH_SNS, NULL);
 	else if (create_shell != NULL)
 		ret = create_shell_pd(fd, create_shell);
