        def _update_freq_visibility(self):
            is_strobe = self.switch_strobe.get_active()
            self.row_freq.set_visible(is_strobe)
            self.row_freq_box.set_visible(is_strobe)

        def _sync_ui_state(self):
            cur = self.hw.get_brightness()
            is_on = cur > 0
            if is_on:
                self.btn_power.add_css_class("active")
                self.icon_power.set_from_icon_name("weather-clear-symbolic")
                pct = int(round((cur / self.hw.max_brightness) * 100))
                self.lbl_status.set_label(f"Active ({pct}%)")
                self.scale_intensity.set_value(cur)
            else:
                self.btn_power.remove_css_class("active")
                self.icon_power.set_from_icon_name("weather-clear-symbolic")
                self.lbl_status.set_label("Flashlight Off")

            pct = int(round((self.scale_intensity.get_value() / self.hw.max_brightness) * 100))
            self.lbl_pct.set_label(f"{pct}%")

        def _on_power_clicked(self, _btn):
            # Stop any active special modes
            if self.strobe_active:
                self.switch_strobe.set_active(False)
            if self.sos_active:
                self.switch_sos.set_active(False)

            if self.hw.is_on():
                self.hw.turn_off()
                self._stop_auto_off_timer()
            else:
                val = int(self.scale_intensity.get_value())
                self.hw.turn_on(val)
                self._start_auto_off_timer_if_configured()

            self._sync_ui_state()

        def _on_intensity_changed(self, scale):
            val = int(scale.get_value())
            pct = int(round((val / self.hw.max_brightness) * 100))
            self.lbl_pct.set_label(f"{pct}%")
            self.config["intensity"] = val
            save_config(self.config)

            # If torch or special modes are on, live-update intensity
            if self.hw.is_on() and not self.strobe_active and not self.sos_active:
                self.hw.set_brightness(val)
                self.lbl_status.set_label(f"Active ({pct}%)")

        def _set_preset(self, fraction):
            val = max(1, int(self.hw.max_brightness * fraction))
            self.scale_intensity.set_value(val)
            if not self.hw.is_on():
                # Clicking preset turns it on at that level
                self.hw.turn_on(val)
                self._start_auto_off_timer_if_configured()
                self._sync_ui_state()

        def _on_strobe_toggled(self, switch, _pspec):
            self._update_freq_visibility()
            if switch.get_active():
                if self.sos_active:
                    self.switch_sos.set_active(False)
                self.strobe_active = True
                self.btn_power.add_css_class("active")
                self.lbl_status.set_label("Strobe Active")
                self.strobe_thread = threading.Thread(target=self._strobe_worker, daemon=True)
                self.strobe_thread.start()
            else:
                self.strobe_active = False
                self.hw.turn_off()
                self._sync_ui_state()

        def _strobe_worker(self):
            while self.strobe_active:
                freq = float(self.scale_freq.get_value())
                delay = 1.0 / (freq * 2)
                val = int(self.scale_intensity.get_value())
                self.hw.set_brightness(val)
                time.sleep(delay)
                self.hw.set_brightness(0)
                time.sleep(delay)
            self.hw.set_brightness(0)

        def _on_freq_changed(self, scale):
            freq = int(scale.get_value())
            self.lbl_freq.set_label(f"{freq} Hz")
            self.config["strobe_freq_hz"] = freq
            save_config(self.config)

        def _on_sos_toggled(self, switch, _pspec):
            if switch.get_active():
                if self.strobe_active:
                    self.switch_strobe.set_active(False)
                self.sos_active = True
                self.btn_power.add_css_class("active")
                self.lbl_status.set_label("SOS Transmitting...")
                self.sos_thread = threading.Thread(target=self._sos_worker, daemon=True)
                self.sos_thread.start()
            else:
                self.sos_active = False
                self.hw.turn_off()
                self._sync_ui_state()

        def _sos_worker(self):
            unit = 0.2
            pattern = [
                (unit, unit), (unit, unit), (unit, unit * 3),        # S (...)
                (unit * 3, unit), (unit * 3, unit), (unit * 3, unit * 3), # O (---)
                (unit, unit), (unit, unit), (unit, unit * 7)         # S (...)
            ]
            while self.sos_active:
                val = int(self.scale_intensity.get_value())
                for on_dur, off_dur in pattern:
                    if not self.sos_active:
                        break
                    self.hw.set_brightness(val)
                    time.sleep(on_dur)
                    self.hw.set_brightness(0)
                    time.sleep(off_dur)
            self.hw.set_brightness(0)

        def _on_timer_selected(self, dropdown, _pspec):
            idx = dropdown.get_selected()
            minutes_map = [0, 1, 2, 5, 10, 15]
            mins = minutes_map[idx]
            self.config["auto_off_minutes"] = mins
            save_config(self.config)
            if self.hw.is_on():
                self._start_auto_off_timer_if_configured()

        def _start_auto_off_timer_if_configured(self):
            self._stop_auto_off_timer()
            mins = self.config.get("auto_off_minutes", 0)
            if mins > 0:
                self.auto_off_remaining_s = mins * 60
                self.auto_off_timer_id = GLib.timeout_add_seconds(1, self._on_auto_off_tick)

        def _stop_auto_off_timer(self):
            if self.auto_off_timer_id:
                GLib.source_remove(self.auto_off_timer_id)
                self.auto_off_timer_id = None
            self.row_timer.set_subtitle("Prevent battery drain and heating")

        def _on_auto_off_tick(self):
            if not self.hw.is_on():
                self._stop_auto_off_timer()
                return False
            self.auto_off_remaining_s -= 1
            if self.auto_off_remaining_s <= 0:
                self.hw.turn_off()
                self._sync_ui_state()
                self._stop_auto_off_timer()
                return False
            m, s = divmod(self.auto_off_remaining_s, 60)
            self.row_timer.set_subtitle(f"Auto-turning off in {m}m {s:02d}s")
            return True

        # --- Screen Lantern Mode ---
        def _open_screen_lantern(self, _btn):
            dialog = Adw.Window(transient_for=self, modal=True, title="Screen Light")
            dialog.set_default_size(480, 520)

            main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            dialog.set_content(main_box)

            d_header = Adw.HeaderBar()
            main_box.append(d_header)

            color_canvas = Gtk.Box(vexpand=True, hexpand=True)
            color_canvas.add_css_class("screen-lantern")
            main_box.append(color_canvas)

            ctrl_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            ctrl_box.set_margin_start(16)
            ctrl_box.set_margin_end(16)
            ctrl_box.set_margin_top(12)
            ctrl_box.set_margin_bottom(16)
            main_box.append(ctrl_box)

            lbl_w = Gtk.Label(label="Color Warmth:")
            ctrl_box.append(lbl_w)

            warmth_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 3, 1)
            warmth_scale.set_hexpand(True)
            warmth_scale.set_value(2)

            def on_warmth_changed(s):
                v = int(s.get_value())
                colors = {
                    1: "#fef3c7", # Warm Candle
                    2: "#fffbeb", # Soft Reading Warmth
                    3: "#ffffff"  # Cool Pure Daylight
                }
                c = colors.get(v, "#ffffff")
                dialog.get_surface()

            ctrl_box.append(warmth_scale)
            dialog.present()

        def _on_key_pressed(self, _ctrl, keyval, _keycode, _state):
            if keyval in (Gdk.KEY_space, Gdk.KEY_Return):
                self._on_power_clicked(None)
                return True
            elif keyval == Gdk.KEY_Up:
                cur = self.scale_intensity.get_value()
                self.scale_intensity.set_value(min(self.hw.max_brightness, cur + 25))
                return True
            elif keyval == Gdk.KEY_Down:
                cur = self.scale_intensity.get_value()
                self.scale_intensity.set_value(max(1, cur - 25))
                return True
            return False

    class TorchApp(Adw.Application):
        def __init__(self):
            super().__init__(application_id="io.github.kumar_jy.torch")

        def do_activate(self):
            win = self.props.active_window
            if not win:
                win = TorchWindow(self)
            win.present()

    app = TorchApp()
    return app.run([])


