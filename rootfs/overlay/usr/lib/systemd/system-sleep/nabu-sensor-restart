#!/usr/bin/bash
# Systemd sleep hook: stop iio-sensor-proxy before suspend.
#
# iio-sensor-proxy does not survive SLPI suspend states: its cached SSC
# discovery goes stale once the Sensor Manager service restarts, so it has to
# be re-probed on resume.
#
# Only the stop happens here. The start lives in hexagonrpcd-resume.service:
# iio-sensor-proxy carries Wants=/After= on the hexagonrpcd unit that the
# resume unit starts, so starting the proxy from this hook (which runs inside
# the suspend.target transaction) is refused by systemd with
# "Transaction for iio-sensor-proxy.service/start is destructive", and the
# proxy then stays dead until someone starts it by hand.
case "${1:-}" in
    pre) systemctl stop iio-sensor-proxy.service 2>/dev/null || true ;;
    post) : ;;
    *) : ;;
esac
exit 0
