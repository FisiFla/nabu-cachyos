# mkinitcpio preset for CachyOS Nabu kernel
# Kernel + initramfs paths point under /boot/efi/ on the ext4 root for
# historical reasons. There is no actual ESP and no GRUB — the boot.img
# embeds the kernel directly. Don't change these paths without also
# updating rootfs/build-rootfs.sh.
#
# The kernel release string (e.g. 6.17.0-sm8150-gc22201bb8db6-dirty) is
# substituted into the paths below by rootfs/build-rootfs.sh. It must match
# /lib/modules/<release> exactly, otherwise mkinitcpio cannot find the
# modules.

ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/efi/vmlinuz-${KERNEL_RELEASE}-cachyos-nabu"

PRESETS=('default')

default_image="/boot/efi/initramfs-${KERNEL_RELEASE}-cachyos-nabu.img"
