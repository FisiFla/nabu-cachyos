#!/usr/bin/env bash
set -euo pipefail

echo "=== nabu-cachyos kernel update guidance ==="
echo
echo "Currently running kernel: $(uname -r)"
echo
echo "There is no on-device kernel-update path on this system."
echo
echo "Boot is direct-boot Android bootimg: the kernel and DTB are baked"
echo "into boot.img and flashed to the boot_b partition. /boot/efi/ is a"
echo "plain directory on the ext4 root, NOT a mounted ESP, and there is"
echo "no GRUB at runtime. Writing files into /boot/efi/ will NOT change"
echo "the running kernel."
echo
echo "To actually update the kernel, do this from the build host (the"
echo "MacBook with the nabu-cachyos repo checked out):"
echo
echo "  1. Build a new boot.img with the desired kernel version:"
echo "       KERNEL_VERSION=x.y.z ./build.sh"
echo "     (or edit the default KERNEL_VERSION in build.sh)"
echo
echo "  2. Package the release artifacts:"
echo "       VBMETA_SOURCE=/path/to/vbmeta_disabled.img \\"
echo "         bash release/create-release.sh"
echo
echo "  3. Put the tablet into fastboot (Vol Down + Power), connect via"
echo "     USB-C, then flash:"
echo "       bash release/dist/join-and-flash.sh"
echo
echo "Before flashing, take a rootfs snapshot on the tablet so you can"
echo "roll back if the new kernel misbehaves:"
echo "       snapshot pre-kernel-update"
echo
echo "Only sm8150/6.14.x kernel branches are known to boot reliably on"
echo "nabu. Other branches (notably 6.16+) may leave the tablet unable"
echo "to boot."
echo
exit 0
