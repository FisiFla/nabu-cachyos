@@ -2216,6 +2216,14 @@ static inline int iris_vpu_dpb_count(struct iris_inst *inst)
 		return 11;
 
 	if (iris_split_mode_enabled(inst)) {
+		/*
+		 * The legacy VPU5 firmware validates the complete buffer set at
+		 * LOAD_RESOURCES, before it reports its own DPB minimum, so the
