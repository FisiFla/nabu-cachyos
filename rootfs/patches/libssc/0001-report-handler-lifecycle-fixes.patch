diff --git a/src/libssc-sensor.c b/src/libssc-sensor.c
index 5947dba..bc61515 100644
--- a/src/libssc-sensor.c
+++ b/src/libssc-sensor.c
@@ -240,6 +240,14 @@ sensor_open (SSCSensor *self, GCancellable *cancellable, GAsyncReadyCallback cal
 	ctx->task = task;
 	ctx->sensor = self;
 
+	/*
+	 * If a previous open is still in flight, its report handler and context
+	 * must be dropped before connecting another one. Otherwise both handlers
+	 * stay connected and the second report dispatches into the already freed
+	 * first context, causing a use-after-free in report_received().
+	 */
+	g_clear_signal_handler (&priv->report_id, priv->client);
+
 	/* Start listening for report signals */
 	priv->report_id = g_signal_connect (priv->client,
 			"report",
@@ -821,6 +829,14 @@ sensor_dispose (GObject *object)
 
 	g_clear_handle_id (&priv->discovery_timeout_id, g_source_remove);
 
+	/*
+	 * Remove the report signal handler before dropping the client.
+	 * If a sensor is disposed while an open request is still in flight,
+	 * the task context would otherwise dangle and a later report would
+	 * dispatch into freed memory (use-after-free in report_received()).
+	 */
+	g_clear_signal_handler (&priv->report_id, priv->client);
+
 	if (priv->name)
 		g_free (priv->name);
 
