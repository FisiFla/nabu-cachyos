# --- Hardware LED Abstraction ---

class TorchHardware:
    """Manages sysfs LED hardware for camera flash / torch on Linux."""

    def __init__(self):
        self.led_path = self._detect_led_path()
        self.max_brightness = self._read_int("max_brightness", default=255)

    def _detect_led_path(self):
        # Specific path for Xiaomi Pad 5 (sm8150 nabu)
        primary = "/sys/class/leds/white:flash"
        if os.path.exists(os.path.join(primary, "brightness")):
            return primary

        # General sysfs probes for mobile Linux & tablets
        patterns = [
            "/sys/class/leds/*:flash",
            "/sys/class/leds/*:torch",
            "/sys/class/leds/*flash*",
            "/sys/class/leds/*torch*",
        ]
        for pat in patterns:
            matches = sorted(glob.glob(pat))
            for p in matches:
                if os.path.exists(os.path.join(p, "brightness")):
                    return p
        return primary

    def _read_int(self, node, default=0):
        if not self.led_path:
            return default
        try:
            with open(os.path.join(self.led_path, node), "r") as f:
                return int(f.read().strip())
        except Exception:
            return default

    def _write_int(self, node, value):
        if not self.led_path:
            return False
        try:
            with open(os.path.join(self.led_path, node), "w") as f:
                f.write(str(int(value)))
            return True
        except PermissionError:
            # Fallback using pkexec/sudo if permissions are missing
            try:
                import subprocess
                p = os.path.join(self.led_path, node)
                subprocess.run(["pkexec", "sh", "-c", f"echo {int(value)} > {p}"],
                               check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
            except Exception:
                return False
        except Exception:
            return False

    def is_available(self):
        return bool(self.led_path and os.path.exists(self.led_path))

    def get_device_name(self):
        if not self.led_path:
            return "No LED Found"
        return os.path.basename(self.led_path)

    def get_brightness(self):
        return self._read_int("brightness", 0)

    def is_on(self):
        return self.get_brightness() > 0

    def set_brightness(self, value):
        val = max(0, min(self.max_brightness, int(value)))
        return self._write_int("brightness", val)

    def turn_on(self, value=None):
        if value is None:
            value = self.max_brightness
        return self.set_brightness(value)

    def turn_off(self):
        return self.set_brightness(0)

    def toggle(self, on_value=None):
        if self.is_on():
            self.turn_off()
            return False
        else:
            self.turn_on(on_value)
            return True


# --- Configuration Storage ---

CONFIG_DIR = Path.home() / ".config" / "torch"
CONFIG_FILE = CONFIG_DIR / "config.json"

DEFAULT_CONFIG = {
    "intensity": 255,
    "strobe_freq_hz": 4,
    "auto_off_minutes": 0,
    "screen_color": [1.0, 0.95, 0.85]  # Warm reading light
}

def load_config():
    if not CONFIG_FILE.exists():
        return DEFAULT_CONFIG.copy()
    try:
        with open(CONFIG_FILE, "r") as f:
            cfg = json.load(f)
            return {**DEFAULT_CONFIG, **cfg}
    except Exception:
        return DEFAULT_CONFIG.copy()

def save_config(cfg):
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(cfg, f, indent=2)
    except Exception:
        pass


# --- CLI Command Handler ---

def run_cli(args):
    hw = TorchHardware()
    cfg = load_config()
    cmd = args[0].lower() if args else "status"

    def parse_intensity(arg, default):
        if not arg:
            return default
        arg = arg.strip()
        if arg.endswith("%"):
            try:
                pct = float(arg[:-1])
                return int((pct / 100.0) * hw.max_brightness)
            except ValueError:
                return default
        try:
            return int(arg)
        except ValueError:
            return default

    if cmd in ("on", "start", "enable"):
        val = parse_intensity(args[1] if len(args) > 1 else None, cfg.get("intensity", hw.max_brightness))
        val = max(1, min(hw.max_brightness, val))
        hw.turn_on(val)
        cfg["intensity"] = val
        save_config(cfg)
        pct = int(round((val / hw.max_brightness) * 100))
        print(f"Torch ON: {val}/{hw.max_brightness} ({pct}%) [{hw.get_device_name()}]")
        return 0

    elif cmd in ("off", "stop", "disable"):
        hw.turn_off()
        print("Torch OFF")
        return 0

    elif cmd in ("toggle", "t"):
        target_val = cfg.get("intensity", hw.max_brightness)
        state = hw.toggle(target_val)
        if state:
            pct = int(round((target_val / hw.max_brightness) * 100))
            print(f"Torch ON: {target_val}/{hw.max_brightness} ({pct}%)")
        else:
            print("Torch OFF")
        return 0

    elif cmd in ("set", "brightness", "level", "intensity"):
        if len(args) < 2:
            print("Error: Specify a brightness value (1-255 or 1-100%).", file=sys.stderr)
            return 1
        val = parse_intensity(args[1], cfg.get("intensity", hw.max_brightness))
        val = max(0, min(hw.max_brightness, val))
        hw.set_brightness(val)
        if val > 0:
            cfg["intensity"] = val
            save_config(cfg)
        pct = int(round((val / hw.max_brightness) * 100))
        print(f"Torch level set to: {val}/{hw.max_brightness} ({pct}%)")
        return 0

    elif cmd in ("status", "get", "info"):
        cur = hw.get_brightness()
        pct = int(round((cur / hw.max_brightness) * 100)) if hw.max_brightness else 0
        state = "ON" if cur > 0 else "OFF"
        print(f"Device:     {hw.get_device_name()} ({hw.led_path})")
        print(f"State:      {state}")
        print(f"Brightness: {cur}/{hw.max_brightness} ({pct}%)")
        print("Author:     Kumar-Jy <https://github.com/Kumar-Jy>")
        return 0

    elif cmd in ("strobe", "flash"):
        freq = float(args[1]) if len(args) > 1 else 4.0
        val = cfg.get("intensity", hw.max_brightness)
        delay = 1.0 / (freq * 2)
        print(f"Strobe active at {freq:.1f} Hz (Ctrl+C to stop)...")
        try:
            while True:
                hw.set_brightness(val)
                time.sleep(delay)
                hw.set_brightness(0)
                time.sleep(delay)
        except KeyboardInterrupt:
            hw.set_brightness(0)
            print("\nStrobe stopped.")
        return 0

    elif cmd == "sos":
        val = cfg.get("intensity", hw.max_brightness)
        print("Transmitting SOS beacon (... --- ...) [Ctrl+C to stop]...")
        unit = 0.2
        pattern = [
            (unit, unit), (unit, unit), (unit, unit * 3),        # S (...)
            (unit * 3, unit), (unit * 3, unit), (unit * 3, unit * 3), # O (---)
            (unit, unit), (unit, unit), (unit, unit * 7)         # S (...)
        ]
        try:
            while True:
                for on_dur, off_dur in pattern:
                    hw.set_brightness(val)
                    time.sleep(on_dur)
                    hw.set_brightness(0)
                    time.sleep(off_dur)
        except KeyboardInterrupt:
            hw.set_brightness(0)
            print("\nSOS stopped.")
        return 0

    elif cmd in ("-h", "--help", "help"):
        print("torch - Hardware Flashlight & Torch Controller v1.0.0")
        print("Created by Kumar-Jy <https://github.com/Kumar-Jy>")
        print("\nUsage: torch [command] [options]")
        print("\nCommands:")
        print("  (none)             Launch graphical torch control interface")
        print("  on [level]         Turn on torch (level: 1-255 or 1-100%)")
        print("  off                Turn off torch")
        print("  toggle             Toggle torch state")
        print("  set <level>        Set torch intensity without changing on/off state")
        print("  status             Show current torch hardware status and brightness")
        print("  strobe [freq_hz]   Blink torch rapidly at given frequency (default: 4 Hz)")
        print("  sos                Emit Morse code SOS emergency distress signal")
        print("  --help, -h         Show this help message")
        return 0

    else:
        # Check if argument is a direct intensity number (e.g. `torch 80%` or `torch 200`)
        val = parse_intensity(cmd, None)
        if val is not None:
            val = max(0, min(hw.max_brightness, val))
            hw.set_brightness(val)
            if val > 0:
                cfg["intensity"] = val
                save_config(cfg)
            pct = int(round((val / hw.max_brightness) * 100))
            print(f"Torch level set to: {val}/{hw.max_brightness} ({pct}%)")
            return 0
        print(f"Unknown command: {cmd}. Use 'torch --help' for usage.", file=sys.stderr)
        return 1


